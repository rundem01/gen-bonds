# Leave unset to run the simulated market — the app is fully explorable
# offline and that is the default for reviewers.

# Address of a GenBonds contract deployed on Studio Next (chain 61997).
# Setting this switches the app to the live backend; if the connection fails it
# falls back to the simulator and says so in the header.
VITE_CONTRACT_ADDRESS=

# Studio Next RPC. studio-next.genlayer.com is a browser alias for the same
# release-candidate stack canonically served at studio-dev.genlayer.com;
# both are chain 61997, which is a different chain identity from stable
# Studionet (61999).
VITE_STUDIO_URL=https://studio-next.genlayer.com/api
