# Leave both unset to run the simulated market — the app is fully explorable
# offline and that is the default for reviewers.

# Address of a deployed GenBonds contract. Setting this switches the app to the
# live backend; if the connection fails it falls back to the simulator and says so.
VITE_CONTRACT_ADDRESS=

# Optional GenLayer Studio / node endpoint. Defaults to the SDK's studionet.
VITE_STUDIO_URL=
